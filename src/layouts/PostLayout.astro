---
import type { CollectionEntry, CollectionKey } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate, pathWithBase } from '../data/site';

interface Props {
  entry: CollectionEntry<CollectionKey>;
  collection: 'life' | 'learning' | 'projects';
  previous?: CollectionEntry<CollectionKey>;
  next?: CollectionEntry<CollectionKey>;
}
const { entry, collection, previous, next } = Astro.props;
const listNames = { life: '生活', learning: '学习成长', projects: '项目' };
const cover = entry.data.cover ? pathWithBase(entry.data.cover) : undefined;
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.cover} article>
  <article class="article-page">
    <header class="article-header">
      <a class="back-link" href={pathWithBase(`/${collection}/`)}>← 返回{listNames[collection]}</a>
      <div class="article-meta"><span>{entry.data.category}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></div>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <div class="tag-row center">{entry.data.tags.map((tag: string) => <a href={pathWithBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}</div>
    </header>
    {cover && <figure class="article-cover"><img src={cover} alt={`${entry.data.title}封面`} /></figure>}
    <div class="prose"><slot /></div>
    <div class="comment-placeholder" aria-label="评论功能预留"><span>✦</span><p>故事先写到这里。评论功能会在未来合适的时候到来。</p></div>
    <nav class="article-pagination" aria-label="文章翻页">
      {previous ? <a href={pathWithBase(`/${collection}/${previous.id}/`)}><small>上一篇</small><strong>{previous.data.title}</strong></a> : <span></span>}
      {next ? <a class="next" href={pathWithBase(`/${collection}/${next.id}/`)}><small>下一篇</small><strong>{next.data.title}</strong></a> : <span></span>}
    </nav>
  </article>
</BaseLayout>
