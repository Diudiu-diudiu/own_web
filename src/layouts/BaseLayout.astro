---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pathWithBase, siteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const { title, description = siteConfig.description, image, article = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(pathWithBase(image), Astro.site) : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f4ec" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </body>
</html>
