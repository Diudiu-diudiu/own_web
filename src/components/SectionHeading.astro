---
interface Props { eyebrow: string; title: string; note?: string; href?: string; linkLabel?: string }
const { eyebrow, title, note, href, linkLabel = '查看全部' } = Astro.props;
---
<div class="section-heading">
  <div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2>{note && <p class="section-note">{note}</p>}</div>
  {href && <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true">↗</span></a>}
</div>
